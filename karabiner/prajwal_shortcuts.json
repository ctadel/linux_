        { "type": "basic", "from": { "key_code": "delete_or_backspace", "modifiers": { "mandatory": ["left_control"], "optional": [] } }, "to": [{ "key_code": "delete_or_backspace", "modifiers": ["left_option"] }] },
        { "type": "basic", "from": { "key_code": "forward_delete", "modifiers": { "mandatory": ["left_control"], "optional": [] } }, "to": [{ "key_code": "forward_delete", "modifiers": ["left_option"] }] }
      ]
    },
